  }, []);

  </span><span class="text-codex-syntax-keyword">if</span><span> (</span><span class="text-codex-syntax-variable">s</span><span class="text-codex-syntax-keyword">.</span><span>loading) {
    </span><span class="text-codex-syntax-keyword">return</span><span> </span><span class="text-codex-syntax-name">&lt;p</span><span> </span><span class="text-codex-syntax-attribute">className</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"state"</span><span class="text-codex-syntax-name">&gt;</span><span>Memuat karya…</span><span class="text-codex-syntax-name">&lt;/p&gt;</span><span>;
  }

