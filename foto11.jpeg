        </span><span class="text-codex-syntax-name">&lt;/div&gt;</span><span>
      </span><span class="text-codex-syntax-name">&lt;/div&gt;</span><span>

      </span><span class="text-codex-syntax-name">&lt;div</span><span> </span><span class="text-codex-syntax-attribute">className</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"stats"</span><span class="text-codex-syntax-name">&gt;</span><span>
        {[
          [
            </span><span class="text-codex-syntax-variable">isComic</span><span>
              </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-string">'Komik'</span><span>
              </span><span class="text-codex-syntax-keyword">:</span><span> </span><span class="text-codex-syntax-variable">typeFilter</span><span> </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-string">'novel'</span><span>
                </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-string">'Novel'</span><span>
                </span><span class="text-codex-syntax-keyword">:</span><span> </span><span class="text-codex-syntax-string">'Semua karya'</span><span>,
            </span><span class="text-codex-syntax-variable">rows</span><span class="text-codex-syntax-keyword">.</span><span>length
          ],
          [</span><span class="text-codex-syntax-string">'Bab / Episode'</span><span>, </span><span class="text-codex-syntax-variable">sum</span><span>(</span><span class="text-codex-syntax-string">'chapters'</span><span>)],
          [</span><span class="text-codex-syntax-string">'Pembaca'</span><span>, </span><span class="text-codex-syntax-variable">sum</span><span>(</span><span class="text-codex-syntax-string">'views'</span><span>)],
