        </span><span class="text-codex-syntax-name">&lt;div</span><span> </span><span class="text-codex-syntax-attribute">className</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"row"</span><span> </span><span class="text-codex-syntax-attribute">style</span><span class="text-codex-syntax-keyword">=</span><span>{{ flexWrap: </span><span class="text-codex-syntax-string">'wrap'</span><span> }}</span><span class="text-codex-syntax-name">&gt;</span><span>
          </span><span class="text-codex-syntax-name">&lt;Link</span><span> </span><span class="text-codex-syntax-attribute">className</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"btn btn-dark"</span><span> </span><span class="text-codex-syntax-attribute">to</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"/penulis"</span><span class="text-codex-syntax-name">&gt;</span><span>
            Semua Karya
          </span><span class="text-codex-syntax-name">&lt;/Link&gt;</span><span>

          </span><span class="text-codex-syntax-name">&lt;Link</span><span>
            </span><span class="text-codex-syntax-attribute">className</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"btn btn-dark"</span><span>
            </span><span class="text-codex-syntax-attribute">to</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"/penulis/novel"</span><span>
          </span><span class="text-codex-syntax-name">&gt;</span><span>
            📖 Novel
          </span><span class="text-codex-syntax-name">&lt;/Link&gt;</span><span>

          </span><span class="text-codex-syntax-name">&lt;Link</span><span>
            </span><span class="text-codex-syntax-attribute">className</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"btn btn-dark"</span><span>
            </span><span class="text-codex-syntax-attribute">to</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"/penulis/komik"</span><span>
          </span><span class="text-codex-syntax-name">&gt;</span><span>
            🎨 Komik
          </span><span class="text-codex-syntax-name">&lt;/Link&gt;</span><span>

          </span><span class="text-codex-syntax-name">&lt;Link</span><span>
            </span><span class="text-codex-syntax-attribute">className</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"btn btn-primary"</span><span>
            </span><span class="text-codex-syntax-attribute">to</span><span class="text-codex-syntax-keyword">=</span><span>{
              </span><span class="text-codex-syntax-variable">isComic</span><span>
                </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-string">'/penulis/novel/baru?type=comic'</span><span>
                </span><span class="text-codex-syntax-keyword">:</span><span> </span><span class="text-codex-syntax-string">'/penulis/novel/baru'</span><span>
            }
          </span><span class="text-codex-syntax-name">&gt;</span><span>
            {</span><span class="text-codex-syntax-variable">isComic</span><span> </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-string">'+ Komik Baru'</span><span> </span><span class="text-codex-syntax-keyword">:</span><span> </span><span class="text-codex-syntax-string">'+ Novel Baru'</span><span>}
