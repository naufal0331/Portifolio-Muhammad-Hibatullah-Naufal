    );
};

</span><span class="text-codex-syntax-keyword">export</span><span> </span><span class="text-codex-syntax-keyword">function</span><span> </span><span class="text-codex-syntax-variable">AuthorDash</span><span>({ typeFilter </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-string">'all'</span><span> }) {
  </span><span class="text-codex-syntax-keyword">const</span><span> [</span><span class="text-codex-syntax-variable">s</span><span>, </span><span class="text-codex-syntax-variable">set</span><span>] </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">useState</span><span>({ loading: </span><span class="text-codex-syntax-literal">true</span><span> });

