    </span><span class="text-codex-syntax-keyword">return</span><span> </span><span class="text-codex-syntax-name">&lt;p</span><span> </span><span class="text-codex-syntax-attribute">className</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"state err"</span><span class="text-codex-syntax-name">&gt;</span><span>{</span><span class="text-codex-syntax-variable">s</span><span class="text-codex-syntax-keyword">.</span><span>error}</span><span class="text-codex-syntax-name">&lt;/p&gt;</span><span>;
  }

  </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">rows</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">s</span><span class="text-codex-syntax-keyword">.</span><span>data</span><span class="text-codex-syntax-keyword">.</span><span>filter(
    </span><span class="text-codex-syntax-variable">n</span><span> =&gt; </span><span class="text-codex-syntax-variable">typeFilter</span><span> </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-string">'all'</span><span> </span><span class="text-codex-syntax-keyword">||</span><span> </span><span class="text-codex-syntax-variable">n</span><span class="text-codex-syntax-keyword">.</span><span>type </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-variable">typeFilter</span><span>
  );

  </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">sum</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">key</span><span> =&gt;
    </span><span class="text-codex-syntax-variable">rows</span><span class="text-codex-syntax-keyword">.</span><span>reduce((</span><span class="text-codex-syntax-variable">total</span><span>, </span><span class="text-codex-syntax-variable">n</span><span>) =&gt; </span><span class="text-codex-syntax-variable">total</span><span> </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-variable">Number</span><span>(</span><span class="text-codex-syntax-variable">n</span><span>[</span><span class="text-codex-syntax-variable">key</span><span>] </span><span class="text-codex-syntax-keyword">||</span><span> </span><span class="text-codex-syntax-literal">0</span><span>), </span><span class="text-codex-syntax-literal">0</span><span>);

  </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">isComic</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">typeFilter</span><span> </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-string">'comic'</span><span>;

  </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">heading</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">isComic</span><span>
    </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-string">'🎨 Dashboard Penulis Komik'</span><span>
    </span><span class="text-codex-syntax-keyword">:</span><span> </span><span class="text-codex-syntax-variable">typeFilter</span><span> </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-string">'novel'</span><span>
      </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-string">'📖 Dashboard Penulis Novel'</span><span>
      </span><span class="text-codex-syntax-keyword">:</span><span> </span><span class="text-codex-syntax-string">'✍️ Dashboard Penulis'</span><span>;

  </span><span class="text-codex-syntax-keyword">return</span><span> (
    </span><span class="text-codex-syntax-name">&lt;&gt;</span><span>
      </span><span class="text-codex-syntax-name">&lt;div</span><span>
        </span><span class="text-codex-syntax-attribute">className</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"row"</span><span>
